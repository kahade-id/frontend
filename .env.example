# Public API. Use HTTPS. Never put secrets into EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.kahade.id

# Fill from the EXISTING Expo/EAS project, not a new or guessed project.
# EAS_PROJECT_ID=
# EAS_OWNER=
# IOS_BUNDLE_IDENTIFIER=
# ANDROID_APPLICATION_ID=
# APP_VERSION=

# APP_VERSION must match the intended native release and the server minimum.
# Use the same values/environment for its native build and subsequent OTA updates.
# Do not publish this audit bundle to an old runtime; see docs/audit/OTA.md.
