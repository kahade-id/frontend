# Public API. Use HTTPS. Never put secrets into EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.kahade.id

# Fill from the EXISTING Expo/EAS project, not a new or guessed project.
# EAS_PROJECT_ID=
# EAS_OWNER=
# IOS_BUNDLE_IDENTIFIER=
# ANDROID_APPLICATION_ID=
# APP_VERSION=

# APP_VERSION must match the intended native release and the server minimum.
# Use the same values/environment for its native build and subsequent OTA updates.
# Do not publish this bundle to an old runtime: APP_VERSION must match the
# native build that receives the update.

# ── Firebase Web Push (FCM untuk browser; web app di Cloudflare) ──────────
# Wajib diisi SEMUA (atau kosongkan semua untuk menonaktifkan web push).
# Ambil dari Firebase Console, project yang SAMA dengan google-services.json
# (project_id "kahade-fcm"):
#   Project settings > General > Your apps > Web app (buat bila belum ada)
#     → API_KEY, AUTH_DOMAIN, PROJECT_ID, STORAGE_BUCKET,
#       MESSAGING_SENDER_ID, APP_ID
#   Project settings > Cloud Messaging > Web Push certificates > Generate key pair
#     → VAPID_KEY
# Nilai-nilai ini public-by-design (ter-embed di bundle web); batasi aksesnya
# lewat Firebase Console (API restrictions / App Check), bukan kerahasiaan.
# Di Cloudflare Pages: isi sebagai Environment Variables (bukan file .env).
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=
