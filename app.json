{
  "expo": {
    "name": "Kahade",
    "slug": "kahade",
    "scheme": "kahade",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-font", "expo-splash-screen"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
