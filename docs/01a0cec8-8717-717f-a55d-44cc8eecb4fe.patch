+        <IconButton
+          icon={PencilSimple}
+          variant="ghost"
+          size="sm"
+          accessibilityLabel="Ubah karya"
+          accessibilityHint={translate("Buka pengelolaan karya etalase")}
+          onPress={() => router.push(ROUTES.showcaseManagement)}
+        />
+      ) : null}
+    </View>
+  )
+}
