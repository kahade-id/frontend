+    expect(result.current.items).toHaveLength(1)
+    await act(async () => slow.resolve([raw("a"), raw("b")]))
+    await waitFor(() => expect(result.current.items).toHaveLength(2))
+    expect(result.current.loading).toBe(false)
+  })
