+        }
+        containerClassName={cn("flex-1 flex-row items-center rounded-md", focusRing)}
+        className="flex-1 flex-row items-center gap-3"
+      >
+        <Avatar
+          source={item.author.avatarUrl ? { uri: item.author.avatarUrl } : undefined}
