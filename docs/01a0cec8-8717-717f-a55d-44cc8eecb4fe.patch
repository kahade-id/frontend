+const owner = { id: "o1", username: "penjual" }
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  let reject!: (reason?: unknown) => void
+  const promise = new Promise<T>((res, rej) => { resolve = res; reject = rej })
+  return { promise, resolve, reject }
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  mocks.dirtyVersion = 0
+  mocks.focused = true
+  mocks.savedIds = []
+  mocks.toggled = []
