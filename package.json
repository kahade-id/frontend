{
  "name": "kahade",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:spec": "node scripts/gen-mobile-spec.mjs",
    "gen:api": "node scripts/gen-mobile-spec.mjs && node scripts/gen-api-types.mjs && node scripts/gen-api-constraints.mjs",
    "gen:inventory": "node scripts/gen-inventory.mjs",
    "check:tokens": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "check:a11y": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-a11y.mjs",
    "check:screens": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-screens.mjs",
    "check:inventory": "node scripts/gen-inventory.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:api": "node scripts/gen-api-constraints.mjs --check && node scripts/audit-inventory.mjs --check && node scripts/check-retry.mjs && node scripts/check-api-body.mjs",
    "check:spec": "node scripts/gen-mobile-spec.mjs --check",
    "check:api:body": "node scripts/check-api-body.mjs",
    "check:api:soft": "node scripts/check-api.mjs && node scripts/check-api-body.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm run audit:classes && npm run check:a11y && npm run check:screens && npm run check:inventory && npm run check:spec && npm run check:api && npm run check:weblinks && npm run check:external-urls && npm run check:time-domains && npm run check:push && npm run check:permissions && npm run check:i18n && npm test && npm run test:components",
    "ota:preflight": "node scripts/check-ota.mjs",
    "ota:rollback": "node scripts/ota-rollback.mjs",
    "audit:inventory": "node scripts/audit-inventory.mjs",
    "audit:classes": "node scripts/audit-class-conflicts.mjs --check",
    "build:web": "EXPO_OFFLINE=1 expo export --platform web && node scripts/gen-web-meta.mjs && node scripts/gen-fcm-sw.mjs",
    "gen:fcm-sw": "node scripts/gen-fcm-sw.mjs",
    "preview:web": "node scripts/serve-web.mjs",
    "gen:brand": "node scripts/gen-brand-assets.mjs",
    "qa:icon": "node scripts/qa-icon.mjs",
    "check:push": "node scripts/check-push.mjs",
    "check:ota": "node scripts/check-ota.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "eas-build-pre-install": "node scripts/check-permissions.mjs && node scripts/check-push.mjs",
    "check:weblinks": "node scripts/check-weblinks.mjs",
    "check:external-urls": "node scripts/check-external-urls.mjs",
    "check:time-domains": "node scripts/check-time-domains.mjs",
    "gen:i18n": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-i18n-catalog.mjs",
    "check:i18n": "npm run gen:i18n -- --check && node scripts/check-i18n.mjs",
    "verify:api": "node scripts/verify-live-api.mjs",
    "test:components": "vitest run --config vitest.components.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.20",
    "firebase": "^12.19.0",
    "nativewind": "^4.1.23",
    "phosphor-react-native": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "axe-core": "^4.13.0",
    "babel-preset-expo": "^54.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1",
    "postcss": "^8.5.23"
  },
  "packageManager": "npm@10.9.8"
}
