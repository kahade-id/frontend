{
  "name": "kahade",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:spec": "node scripts/gen-mobile-spec.mjs",
    "gen:api": "node scripts/gen-mobile-spec.mjs && node scripts/gen-api-types.mjs && node scripts/gen-api-constraints.mjs",
    "gen:inventory": "node scripts/gen-inventory.mjs",
    "check:tokens": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "check:a11y": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-a11y.mjs",
    "check:screens": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-screens.mjs",
    "check:inventory": "node scripts/gen-inventory.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:api": "node scripts/gen-api-constraints.mjs --check && node scripts/audit-inventory.mjs --check && node scripts/check-retry.mjs && node scripts/check-api-body.mjs",
    "check:spec": "node scripts/gen-mobile-spec.mjs --check",
    "check:api:body": "node scripts/check-api-body.mjs",
    "check:api:soft": "node scripts/check-api.mjs && node scripts/check-api-body.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm run audit:classes && npm run check:a11y && npm run check:screens && npm run check:inventory && npm run check:spec && npm run check:api && npm run check:weblinks && npm run check:external-urls && npm run check:time-domains && npm run check:push && npm run check:permissions && npm run check:sdk && npm run check:i18n && npm test && npm run test:components",
    "ota:preflight": "node scripts/check-ota.mjs",
    "ota:rollback": "node scripts/ota-rollback.mjs",
    "audit:inventory": "node scripts/audit-inventory.mjs",
    "audit:classes": "node scripts/audit-class-conflicts.mjs --check",
    "build:web": "EXPO_OFFLINE=1 expo export --platform web && node scripts/gen-web-meta.mjs && node scripts/gen-fcm-sw.mjs",
    "gen:fcm-sw": "node scripts/gen-fcm-sw.mjs",
    "preview:web": "node scripts/serve-web.mjs",
    "gen:brand": "node scripts/gen-brand-assets.mjs",
    "qa:icon": "node scripts/qa-icon.mjs",
    "check:push": "node scripts/check-push.mjs",
    "check:ota": "node scripts/check-ota.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:sdk": "node scripts/check-sdk-contract.mjs",
    "eas-build-pre-install": "node scripts/check-permissions.mjs && node scripts/check-push.mjs",
    "check:weblinks": "node scripts/check-weblinks.mjs",
    "check:external-urls": "node scripts/check-external-urls.mjs",
    "check:time-domains": "node scripts/check-time-domains.mjs",
    "gen:i18n": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-i18n-catalog.mjs",
    "check:i18n": "npm run gen:i18n -- --check && node scripts/check-i18n.mjs",
    "verify:api": "node scripts/verify-live-api.mjs",
    "test:components": "vitest run --config vitest.components.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.11",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "^58.0.3",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.0.3",
    "expo-asset": "~58.0.11",
    "expo-audio": "~58.0.5",
    "expo-auth-session": "~58.0.8",
    "expo-brightness": "~58.0.2",
    "expo-camera": "~58.0.8",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.9",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.5",
    "expo-font": "~58.0.6",
    "expo-haptics": "~58.0.4",
    "expo-image": "~58.0.11",
    "expo-image-manipulator": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.3",
    "expo-location": "~58.0.11",
    "expo-media-library": "~58.0.7",
    "expo-notifications": "~58.1.0",
    "expo-router": "~58.0.13",
    "expo-screen-capture": "~58.0.5",
    "expo-screen-orientation": "~58.0.2",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.14",
    "expo-splash-screen": "~58.0.5",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.14",
    "expo-video": "~58.0.6",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.5",
    "firebase": "^12.19.0",
    "nativewind": "^4.2.7",
    "phosphor-react-native": "^3.0.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "5.1.1",
    "react-native-web": "~0.21.3",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "axe-core": "^4.13.0",
    "babel-preset-expo": "~58.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-dev-client": "~58.0.11",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "expo-passkeys": "^0.1.11"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1",
    "postcss": "^8.5.23"
  },
  "packageManager": "npm@10.9.8"
}
