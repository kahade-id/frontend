{
  "name": "kahade",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:api": "node scripts/gen-api-types.mjs && node scripts/gen-api-constraints.mjs",
    "gen:inventory": "node scripts/gen-inventory.mjs",
    "check:tokens": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "check:a11y": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-a11y.mjs",
    "check:screens": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-screens.mjs",
    "check:inventory": "node scripts/gen-inventory.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:api": "node scripts/gen-api-constraints.mjs --check && node scripts/audit-inventory.mjs --check",
    "check:api:soft": "node scripts/check-api.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm run check:a11y && npm run check:screens && npm run check:inventory && npm run check:api:soft && npm run check:weblinks && npm run check:push && npm test",
    "ota:preflight": "node scripts/check-ota.mjs",
    "audit:inventory": "node scripts/audit-inventory.mjs",
    "build:web": "EXPO_OFFLINE=1 expo export --platform web",
    "preview:web": "node scripts/serve-web.mjs",
    "gen:brand": "node scripts/gen-brand-assets.mjs",
    "qa:icon": "node scripts/qa-icon.mjs",
    "check:push": "node scripts/check-push.mjs",
    "eas-build-pre-install": "node scripts/check-push.mjs",
    "check:weblinks": "node scripts/check-weblinks.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.20",
    "nativewind": "^4.1.23",
    "phosphor-react-native": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.12",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "packageManager": "npm@10.9.8"
}
